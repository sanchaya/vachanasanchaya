<style>
  .admin-section { margin-bottom: 20px; }
  .admin-section h4 { border-bottom: 2px solid #eee; padding-bottom: 8px; margin-bottom: 12px; }
  .admin-card { background: #f9f9f9; border: 1px solid #e0e0e0; border-radius: 4px; padding: 12px; margin-bottom: 10px; }
  .admin-card:hover { background: #f0f0f0; }
  .admin-card .name { font-size: 14px; font-weight: bold; }
  .admin-card .meta { font-size: 12px; color: #666; }
  .admin-card .actions { margin-top: 6px; }
  .admin-card .actions a { margin-right: 6px; }
  .admin-form { margin: 0; }
  .admin-form input[type="text"] { margin-bottom: 0; }
  .result-count { font-size: 12px; color: #999; margin: 5px 0; }
</style>

<h3 style="margin-bottom: 4px;">ನಿರ್ವಹಣಾ ಸಲಕರಣೆಗಳು</h3>
<p style="color: #666; font-size: 13px;">
  ಒಟ್ಟು <%= Vachanakaara.count %> ವಚನಕಾರರು, <%= Vachana.count %> ವಚನಗಳು
  | Exact: <%= @exact_count %> | Like: <%= @like_count %> | ಒಟ್ಟು: <%= @total %>
</p>

<hr/>

<div class="row">
  <div class="span6">
    <div class="admin-section">
      <h4>ವಚನಕಾರರ ನಿರ್ವಹಣೆ</h4>
      <%= form_tag admin_panel_path, method: :get, class: "admin-form" do %>
        <div class="input-append">
          <%= text_field_tag :va_name, params[:va_name], placeholder: "ವಚನಕಾರರ ಹೆಸರು ಹುಡುಕಿ", style: "width: 250px;" %>
          <%= submit_tag "ಹುಡುಕು", class: "btn btn-primary" %>
        </div>
      <% end %>

      <% if @va_results %>
        <div class="result-count"><%= @va_results.count %> ಫಲಿತಾಂಶಗಳು</div>
        <% @va_results.each do |va| %>
          <div class="admin-card">
            <div class="name"><%= va.name %></div>
            <div class="meta">
              ಅಂಕಿತ ನಾಮ: <%= va.ankitha_naama.presence || "—" %>
              <% if va.time_period.present? %> | ಕಾಲ: <%= va.time_period %><% end %>
              <% if va.birth_place.present? %> | ಸ್ಥಳ: <%= va.birth_place %><% end %>
              | ವಚನಗಳು: <%= va.vachanas.count %>
            </div>
            <div class="actions">
              <%= link_to "ಪ್ರೊಫೈಲ್ ಸಂಪಾದಿಸಿ", edit_vachanakaara_path(va), class: "btn btn-mini btn-primary" %>
              <%= link_to "ವಚನಗಳನ್ನು ಸಂಪಾದಿಸಿ", vachanakaara_path(va), class: "btn btn-mini" %>
            </div>
          </div>
        <% end %>
        <% if @va_results.empty? %>
          <div class="admin-card"><em>ಯಾವುದೇ ಫಲಿತಾಂಶಗಳಿಲ್ಲ</em></div>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="span6">
    <div class="admin-section">
      <h4>ವಚನಗಳ ನಿರ್ವಹಣೆ</h4>

      <div class="admin-card">
        <strong>ವಚನ ಸಂಖ್ಯೆ ಹುಡುಕಿ</strong>
        <%= form_tag admin_panel_path, method: :get, class: "admin-form" do %>
          <div class="input-append" style="margin-top: 5px;">
            <%= text_field_tag :vachana_number, params[:vachana_number], placeholder: "ವಚನ ಕ್ರ.ಸಂ", style: "width: 120px;" %>
            <%= submit_tag "ಹುಡುಕು", class: "btn btn-primary" %>
          </div>
        <% end %>
      </div>

      <% if @vachana_number_results %>
        <div class="result-count"><%= @vachana_number_results.count %> ಫಲಿತಾಂಶಗಳು</div>
        <% @vachana_number_results.each do |v| %>
          <div class="admin-card">
            <div class="name"><%= v.vachanakaara&.name %> — ಕ್ರ.ಸಂ <%= v.vachanaid %></div>
            <div class="meta"><%= truncate(v.vachana, length: 120) %></div>
            <div class="actions">
              <%= link_to "ಸಂಪಾದಿಸಿ", edit_vachana_path(v), class: "btn btn-mini btn-primary" %>
              <%= link_to "ವೀಕ್ಷಿಸಿ", vachana_path(v), class: "btn btn-mini" %>
            </div>
          </div>
        <% end %>
        <% if @vachana_number_results.empty? %>
          <div class="admin-card"><em>ಯಾವುದೇ ಫಲಿತಾಂಶಗಳಿಲ್ಲ</em></div>
        <% end %>
      <% end %>

      <div class="admin-card" style="margin-top: 15px;">
        <strong>ವಚನ ಪಠ್ಯ ಹುಡುಕಿ</strong>
        <%= form_tag admin_panel_path, method: :get, class: "admin-form" do %>
          <div class="input-append" style="margin-top: 5px;">
            <%= text_field_tag :vachana_text, params[:vachana_text], placeholder: "ವಚನ ಪಠ್ಯ", style: "width: 200px;" %>
            <%= submit_tag "ಹುಡುಕು", class: "btn btn-primary" %>
          </div>
        <% end %>
      </div>

      <% if @vachana_text_results %>
        <div class="result-count"><%= @vachana_text_results.count %> ಫಲಿತಾಂಶಗಳು</div>
        <% @vachana_text_results.each do |v| %>
          <div class="admin-card">
            <div class="name"><%= v.vachanakaara&.name %> — ಕ್ರ.ಸಂ <%= v.vachanaid %></div>
            <div class="meta"><%= truncate(v.vachana, length: 120) %></div>
            <div class="actions">
              <%= link_to "ಸಂಪಾದಿಸಿ", edit_vachana_path(v), class: "btn btn-mini btn-primary" %>
              <%= link_to "ವೀಕ್ಷಿಸಿ", vachana_path(v), class: "btn btn-mini" %>
            </div>
          </div>
        <% end %>
        <% if @vachana_text_results.empty? %>
          <div class="admin-card"><em>ಯಾವುದೇ ಫಲಿತಾಂಶಗಳಿಲ್ಲ</em></div>
        <% end %>
      <% end %>
    </div>
  </div>
</div>