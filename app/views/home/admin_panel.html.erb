<div class="row"> 
  <div class="span4">
    <h4>ಸ್ಥಿರ ಪುಟಗಳು</h4>
    <ul>
      <% @static_pages.each do |page| %>
        <li><%= link_to "#{page.title} (#{page.locale})", edit_static_page_path(page) %></li>
      <% end %>
    </ul>
    <hr/>

    <h4>ವಚನಕಾರರು (<%= Vachanakaara.count %>)</h4>
    <%= form_tag search_vachanakaara_name_vachanakaaras_path, method: :get, style: "margin-bottom: 5px;" do %>
      <%= text_field_tag :vachanakaara_name, nil, placeholder: "ವಚನಕಾರರ ಹೆಸರು ಹುಡುಕಿ", style: "width: 180px;" %>
      <%= submit_tag "ಹುಡುಕು", class: "btn btn-small" %>
    <% end %>
    <%= link_to "ವಚನಕಾರರ ಪಟ್ಟಿ ಮತ್ತು ಸಂಪಾದನೆ", edit_vachanakaara_path(Vachanakaara.first), class: "btn btn-small" %>

    <hr/>

    <h4>ವಚನಗಳು (<%= Vachana.count %>)</h4>
    <%= form_tag search_vachana_number_vachanas_path, method: :get, style: "margin-bottom: 5px;" do %>
      <%= text_field_tag :vachana_number, nil, placeholder: "ವಚನ ಸಂಖ್ಯೆ ಹುಡುಕಿ", style: "width: 120px;" %>
      <%= submit_tag "ಹುಡುಕು", class: "btn btn-small" %>
    <% end %>
    <div style="margin-bottom: 5px;">
      <%= form_tag vachanas_path, method: :get, style: "display:inline;" do %>
        <%= text_field_tag :vachana, nil, placeholder: "ವಚನ ಪಠ್ಯ ಹುಡುಕಿ", style: "width: 120px;" %>
        <%= hidden_field_tag :search_type, "like_search" %>
        <%= submit_tag "ಹುಡುಕು", class: "btn btn-small" %>
      <% end %>
    </div>

    <hr/>

    <ol> 
      <li>  <%= link_to "ಆಕರಗಳು", reference_books_path %> </li> 
      <li> <%= link_to "ಬಳಕೆದಾರರು", users_path %> </li>
      <li> <%= link_to "ಬದಲಾವಣೆಯನ್ನು ಗಮನಿಸಿ ", activities_path %> </li>
      <li><%= link_to "ಪರಿಶೀಲಿಸಿದ ವಚನಗಳು ", user_publishers_path(current_user)  %> </li>
      <li> <%= link_to "Full vachana search ", search_vachana_vachanas_path %> </li> 
      <li><%= link_to "ಬಳಕೆದಾರರ ಪ್ರತಿಕ್ರಿಯೆಗಳು #{'(' + @pending_feedbacks_count.to_s + ')' if @pending_feedbacks_count > 0}", feedbacks_path, style: 'font-weight:bold;' %></li>
    </ol>

    <%= link_to "Download KeyWords as CSV", download_keyword_csv_word_lists_path %> 
    <br />
    <%= link_to "Download vachanakaaras info as CSV", download_vachanakaara_csv_vachanakaaras_path %> 

    <br/>
    <%= link_to "Download all vachanas as CSV", download_all_vachana_csv_vachanakaaras_path %> 
    <br />
    <%= link_to "Download Vachanakaara unique words", download_vachanakaara_keyword_csv_word_lists_path %>
    <br />
    <%= link_to "Publish all vachanas", publish_all_vachanas_user_publishers_path(current_user) %>
  </div>
  <div class="span5">
    <h4> Total Exact Search : <span class='btn btn-info'> <%= @exact_count %></span></h4>
    <h4> Total Like Search  : <span class='btn btn-info'> <%= @like_count %></span></h4>
    <h4> Total Search  : <span class='btn btn-info'> <%= @total %></span></h4>
  </div>
</div>